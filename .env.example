# RepoScroller Configuration

# Application settings
APP_NAME=RepoScroller
APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8090

# Database
DB_PATH=reposcroller_ledger.db

# Storage Mounts (comma-separated or JSON list)
# Default roots from POC:
STORAGE_ROOTS=["\\\\SyNAS\\xcloud\\docs","\\\\SyNAS\\xcloud\\LawSuiteRAG","\\\\SyNAS\\CloudSpace\\LexSpace","H:\\My Drive","L:\\My Drive","G:\\My Drive"]

# Crawler Settings
POLL_INTERVAL_SECONDS=10
FAST_SCAN_ENABLED=true
SUPPORTED_EXTENSIONS=[".pdf",".docx",".txt",".md",".eml"]

# Deduplication & Near-duplicate thresholds
SIMHASH_HAMMING_THRESHOLD=6  # 0-3: near exact, 4-8: draft/variant, >8: distinct
SIMILARITY_SCORE_THRESHOLD=0.85

# Heuristic Maturity Weights
MATURITY_WEIGHT_COMPLETENESS=0.35
MATURITY_WEIGHT_SIGNATURES=0.25
MATURITY_WEIGHT_DATE=0.20
MATURITY_WEIGHT_NAMING=0.20
