# ==============================================================================
# RepoScroller Sovereign Studio - Environment Configuration Template
# ==============================================================================

# Core Application settings
APP_NAME=RepoScroller
APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8090

# Database
DB_PATH=reposcroller_ledger.db
SQLITE_TIMEOUT=30.0

# Storage Mounts (6 distributed repositories: SMB NAS + Google Drives)
STORAGE_ROOTS=["\\\\SyNAS\\xcloud\\docs","\\\\SyNAS\\xcloud\\LawSuiteRAG","\\\\SyNAS\\CloudSpace\\LexSpace","H:\\My Drive","L:\\My Drive","G:\\My Drive"]

# Crawler & Scanner Settings
POLL_INTERVAL_SECONDS=10
FAST_SCAN_ENABLED=true
SCAN_ORDER=antichronological
SCAN_PARALLEL_WORKERS=6
MAX_FILE_SIZE_BYTES=524288000
SUPPORTED_EXTENSIONS=[".pdf",".docx",".txt",".md",".eml"]

# Deduplication & Near-duplicate thresholds (64-bit SimHash Hamming distance)
SIMHASH_EXACT_THRESHOLD=3
SIMHASH_HAMMING_THRESHOLD=12
SIMILARITY_SCORE_THRESHOLD=0.80

# Heuristic Maturity Weights (Sum = 1.0)
MATURITY_WEIGHT_COMPLETENESS=0.35
MATURITY_WEIGHT_SIGNATURES=0.25
MATURITY_WEIGHT_DATE=0.20
MATURITY_WEIGHT_NAMING=0.20

# ------------------------------------------------------------------------------
# Split Workload Hardware Routing (PC1 Local CPU vs PC2 Remote CUDA GPU)
# ------------------------------------------------------------------------------
# PC1 Localhost (CPU Reasoning, Taxonomy, & Conversational Q&A):
OLLAMA_CHAT_BASE_URL=http://localhost:11434
LLM_PROVIDER=auto
OLLAMA_MODEL=llama3.2

# PC2 Remote Compute Node (CUDA RTX 3060 Tensor Embeddings):
OLLAMA_EMBED_BASE_URL=http://192.168.192.9:11434
EMBEDDING_PROVIDER=auto
OLLAMA_EMBEDDING_MODEL=snowflake-arctic-embed2:latest
OLLAMA_TIMEOUT=60.0
OLLAMA_KEEP_ALIVE=24h
OLLAMA_SUB_BATCH_SIZE=32

# Fallback Base URL
OLLAMA_BASE_URL=http://localhost:11434

# Chunking & Knowledge Base Sidecar Settings
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
KB_SIDECAR_BATCH_SIZE=10
VECTOR_STORE_PATH=reposcroller_vectors

# Optional: Cloud LLM Fallback (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional: Vector Store Backend ('sqlite' or 'qdrant')
VECTOR_STORE_TYPE=sqlite
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=reposcroller_chunks

# Optional: Knowledge Graph Backend ('sqlite' or 'neo4j')
GRAPH_STORE_TYPE=sqlite
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
